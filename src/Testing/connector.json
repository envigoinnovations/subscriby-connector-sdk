{
    "$schema": "../../connector.schema.json",
    "key": "fake",
    "name": "Fake Connector",
    "version": "0.1.0",
    "sdk": "^1.0",
    "vendor": "Subscriby",
    "install": {
        "mode": "paste_credential",
        "scopes": ["project", "platform"]
    },
    "resource_kinds": [
        {
            "kind": "room",
            "label": "Room",
            "portal_label": "Private room",
            "icon": "home",
            "grant_mode": "membership"
        },
        {
            "kind": "errand",
            "label": "Errand",
            "portal_label": "Personal perk",
            "icon": "clipboard-document-check",
            "grant_mode": "creator_task",
            "plan_kinds": ["one_time", "recurring"]
        }
    ],
    "capabilities": ["messaging", "broadcasts", "access_control", "management_surface", "portal_login", "recovery_probes"],
    "messaging": {
        "max_length": 280,
        "buttons_per_row": 2,
        "max_buttons": 4,
        "callback_data_bytes": 32,
        "supports_underline": false,
        "supports_spoiler": false,
        "supports_files": false
    },
    "pacing": {
        "min_interval_microseconds": 1000000,
        "burst": 1,
        "per_recipient_interval_microseconds": 1000000
    },
    "management_commands": ["project_settings", "plan_manage", "resource_manage"],
    "relay_modes": [],
    "recovery": { "probes": true },
    "listing": {
        "category": "community",
        "tagline": "A stand-in connector for tests and local demos",
        "overview": "Exercises every connector surface without talking to a real platform.",
        "screenshots": [],
        "links": { "documentation": "https://docs.subscriby.net/sdk/v1/building" },
        "added_at": "2026-09-10",
        "sign_in_required": false,
        "portal_cta": { "label": "Open the fake room" },
        "seo": {
            "title": "Fake Membership Bot for Paid Rooms and Halls",
            "description": "Sell access to a paid fake room with your own fake bot: members pay, are admitted the moment they pay and are removed when access ends.",
            "h1": "The Fake Membership Bot for Paid Rooms",
            "h1_sub": "A stand-in landing page that exercises every field of the block.",
            "sections": [
                { "heading": "How a paid fake room works", "body": "A creator connects a fake bot and adds the rooms it runs.\n\nA member pays through any of the :gateways payment methods and is let in at once." }
            ],
            "faq": [
                { "q": "Do I need my own fake bot?", "a": "Yes, and it takes a minute to make one." },
                { "q": "Are members removed when they stop paying?", "a": "The moment their access ends." }
            ]
        },
        "marketing": {
            "audience": "fake communities",
            "place": "room",
            "places": "rooms and halls",
            "installation": "fake bot",
            "identity": "fake account"
        }
    }
}
